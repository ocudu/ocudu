set -e

FILE_EXTENSION_REGEX='.*\.(cpp|cc|c\+\+|cxx|c|cl|cu|cuh|h|hh|hpp)$'

# Only consider files that are staged for this commit, so unstaged changes in other files are never pulled in
staged=$(git diff --cached --name-only --relative --diff-filter=d | grep -E "$FILE_EXTENSION_REGEX" || true)
[ -n "$staged" ] || exit 0

# Files that also have unstaged changes cannot be re-staged without committing those changes too, so reject the commit
partial=$(git diff --name-only --relative -- $staged)
if [ -n "$partial" ]; then
    echo "pre-commit: the following files have both staged and unstaged changes:"
    for f in $partial; do
        echo "    $f"
    done
    echo "pre-commit: stage or stash the remaining changes (e.g. 'git stash --keep-index') and commit again"
    exit 1
fi
files=$staged

if [ -n "$OCUDU_CLANG_FORMAT" ] && [ -x "$OCUDU_CLANG_FORMAT" ]; then
    clang_format=$OCUDU_CLANG_FORMAT
elif ! clang_format=$(command -v clang-format); then
    echo "Please install clang-format or set OCUDU_CLANG_FORMAT to a valid executable"
    exit 1
fi

echo "Running clang-format on staged files"
"$clang_format" --version

# Same flags as .gitlab/ci/static/run-clang-format-diff.sh, so per-directory overrides of third-party code keep applying
"$clang_format" -style=file -fallback-style=none -i $files

# Re-stage the files clang-format reformatted; the check above guarantees they had no other unstaged changes
git diff --name-only -- $files | xargs -r git add
