{
    "config": {
        // Nested list indentation, matching prettier's default tabWidth.
        "MD007": { "indent": 2 },

        // Wrap paragraphs at 120, but leave tables and code blocks as they are.
        "MD013": { "line_length": 120, "code_blocks": false, "tables": false }
    },

    "overrides": [
        {
            // The logo of the top-level README needs a width, which markdown image syntax can not express.
            "filter": ["README.md"],
            "config": { "MD033": { "allowed_elements": ["img"] } },
            "combine": "merge"
        }
    ]
}
