{
    // Nested list indentation, matching prettier's default tabWidth.
    "MD007": { "indent": 2 },

    // Wrap paragraphs at 120, but leave tables and code blocks as they are.
    "MD013": { "line_length": 120, "code_blocks": false, "tables": false },

    // Markdown image syntax can not express width.
    "MD033": { "allowed_elements": ["img"] },
}
